# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_botfather_token_here
# Optional: proxy for Telegram API (e.g. socks5://127.0.0.1:1080 or http://user:pass@host:port)
TELEGRAM_PROXY=
# Timeout in seconds (increase if on a slow/blocked network)
TELEGRAM_CONNECT_TIMEOUT=30
TELEGRAM_READ_TIMEOUT=30

# ── LLM: Claude (primary) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-5

# ── LLM: Ollama (fallback when ANTHROPIC_API_KEY is missing/empty) ─────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Gamma AI (presentation builder) ──────────────────────────────────────
GAMMA_API_KEY=your_gamma_api_key_here

# ── Agent behaviour ───────────────────────────────────────────────────────
# Max messages kept in per-user history (user+assistant pairs counted separately)
MAX_HISTORY=40
